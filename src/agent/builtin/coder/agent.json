{
  "name": "Coder",
  "description": "Answers engineering questions, reviews pull requests, and makes requested changes.",
  "permissions": "workspace-write",
  "integrations": {
    "github": {
      "events": {
        "pull_request": {
          "flow": "review",
          "permissions": "read-only"
        },
        "mention": true,
        "issue": true,
        "comment": {
          "match": "[Cc]oder"
        }
      }
    },
    "slack": {
      "events": {
        "mention": true,
        "dm": true,
        "command": true,
        "channel": {
          "match": "[Cc]oder"
        }
      }
    },
    "linear": {
      "events": {
        "mention": true
      }
    }
  }
}
