{
  "name": "Coder",
  "description": "Answers engineering questions, reviews pull requests, and makes requested changes.",
  "integrations": {
    "github": {
      "events": {
        "pull_request": true,
        "mention": true,
        "issue": true,
        "comment": {
          "match": "[Cc]oder"
        }
      }
    },
    "slack": {
      "events": {
        "mention": true,
        "dm": true,
        "channel": {
          "match": "[Cc]oder"
        }
      }
    },
    "linear": {
      "events": {
        "mention": true,
        "issue": true,
        "comment": {
          "match": "[Cc]oder"
        }
      }
    }
  }
}
